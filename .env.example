# Supabase (Project Settings → API). For the local stack, `npx supabase status` prints these.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Feature flags for sign-in methods that need external credentials (leave false until configured)
EXPO_PUBLIC_ENABLE_PHONE_AUTH=false
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Public base URL used in Ijazah QR codes / verification links
EXPO_PUBLIC_VERIFY_BASE_URL=https://mujaz.app/verify

# Release config (read by app.config.ts)
APP_BUNDLE_ID=com.mujaz.app
EAS_PROJECT_ID=

# Server-side only — set as Supabase Edge Function secrets, NEVER as EXPO_PUBLIC_*:
#   npx supabase secrets set DAILY_API_KEY=...
