    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.30",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
